
# ============================================================
# FRONTEND PROJECT .GITIGNORE
# Node.js | React | Next.js | Vite | TypeScript | Tailwind CSS
# ============================================================


# ------------------------------------------------------------
# 1. DEPENDENCIES
# ------------------------------------------------------------

node_modules/
**/node_modules/

jspm_packages/
bower_components/

.pnp.*
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# Keep Yarn Berry releases/plugins/config if used


# ------------------------------------------------------------
# 2. ENVIRONMENT VARIABLES & SECRETS
# ------------------------------------------------------------

.env
.env.*
!.env.example
!.env.sample
!.env.template

*.pem
*.key
*.p12
*.pfx

secrets/
.secrets/

# Do not store API keys, private keys, or tokens in Git


# ------------------------------------------------------------
